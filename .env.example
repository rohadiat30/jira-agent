# ============================================================
# Konfigurasi Jira-Kiro Watcher
# Salin file ini menjadi ".env" lalu isi nilainya.
# JANGAN commit file .env yang berisi token asli.
# ============================================================

# Server (dipakai hanya bila nanti pakai webhook; polling tidak wajib)
PORT=3000

# --- Koneksi Jira ---
JIRA_BASE_URL=https://jira.bri.co.id
JIRA_TOKEN=PASANG_TOKEN_BARU_DI_SINI
JIRA_USERNAME=90186003
# "bearer" untuk Personal Access Token (PAT), "basic" untuk username:password
JIRA_AUTH_TYPE=bearer
# Set "true" bila Jira memakai sertifikat SSL self-signed / gagal SSL di jaringan korporat
JIRA_SKIP_SSL=false

# --- Apa yang dipantau ---
# JQL untuk memilih subtask yang dipantau. Sesuaikan project key Anda.
JIRA_JQL=project = QCASH AND issuetype = Sub-task
# Nama status pemicu (harus PERSIS sama dengan yang ada di board Jira, case-sensitive)
TRIGGER_STATUS=In Development
# Interval polling dalam detik
POLL_INTERVAL_SECONDS=30

# --- Repo target ---
# Path absolut repo tempat file task akan ditulis (tempat Kiro IDE dibuka)
TARGET_REPO_PATH=C:\Users\rohad\Documents\work\qcash-ui-fund-transfer
# Subfolder di dalam repo target tempat file task ditulis
TASK_OUTPUT_DIR=.kiro/tasks

# --- Eksekusi otomatis via Kiro CLI (headless) ---
# true = setelah file task ditulis, watcher memanggil Kiro CLI untuk mengeksekusinya.
# Butuh Kiro CLI terinstall + terautentikasi.
AUTO_EXECUTE=false
# Command/paths Kiro CLI (default: kiro-cli)
KIRO_CLI_COMMAND=kiro-cli
# "all" untuk --trust-all-tools, atau daftar kategori mis. "read,write,grep"
KIRO_TRUST_TOOLS=all
# Agent engine opsional: v1 | v2 | v3 (kosongkan untuk default)
KIRO_AGENT_ENGINE=
# API key Kiro — OPSIONAL untuk pemakaian lokal.
# Bila Anda sudah menjalankan "kiro-cli login" di mesin ini, biarkan KOSONG;
# CLI otomatis memakai sesi login browser. Isi hanya untuk CI/CD tanpa browser.
KIRO_API_KEY=
